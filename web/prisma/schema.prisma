datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum ModelType {
  tabular_classifier
  tabular_regressor
  llm_app
  rag_system
  agent
  other
}

enum RiskTier {
  minimal
  limited
  high
  unacceptable
}

enum AssessmentStatus {
  draft
  intake_complete
  running
  completed
}

enum ArtifactKind {
  dataset
  model
  documentation
  llm_config
}

model AiSystem {
  id                 String       @id @default(uuid())
  name               String
  description        String?
  purpose            String
  intendedUse        String
  modelType          ModelType
  riskTier           RiskTier?
  domainContext      String
  sensitiveAttributes String[]    @default([])
  owner              String
  llmConfig          Json?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  assessments       Assessment[]
}

model Assessment {
  id            String           @id @default(uuid())
  aiSystemId    String
  aiSystem      AiSystem         @relation(fields: [aiSystemId], references: [id], onDelete: Cascade)
  status        AssessmentStatus @default(draft)
  runDataRisk   Boolean          @default(false)
  runSecurity   Boolean          @default(false)
  runGovernance Boolean          @default(false)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  artifacts     Artifact[]
  findings      Finding[]
  controls      Control[]
  scores        ScoreSnapshot[]
}

model Artifact {
  id          String       @id @default(uuid())
  assessmentId String
  assessment  Assessment   @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  kind        ArtifactKind
  filename    String
  mime        String
  size        Int
  storageKey  String
  uploadedAt  DateTime     @default(now())
}

model Finding {
  id             String     @id @default(uuid())
  assessmentId   String
  assessment     Assessment @relation(fields: [assessmentId], references: [id])
  module         String
  domain         String
  checkId        String
  title          String
  description    String
  severity       String
  evidence       Json
  recommendation String
  status         String     @default("open")
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
}

model Control {
  id           String     @id @default(uuid())
  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id])
  name         String
  description  String
  status       String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model ScoreSnapshot {
  id           String     @id @default(uuid())
  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id])
  overall      Float
  domains      Json
  createdAt    DateTime   @default(now())
}
